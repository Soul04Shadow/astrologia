# Copy to backend/.env and fill in at least one provider — ordered by recommended defaults (zen → nvidia → groq → openrouter)
LLM_PROVIDER=cliproxy
CLIPROXY_BASE_URL=http://127.0.0.1:8317/v1
CLIPROXY_API_KEY=
CLIPROXY_MODEL=gemini-3.8-flash

ZEN_API_KEY=
ZEN_MODEL=ox-alpha-free
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=stealth/ox-alpha:free
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

LMSTUDIO_MODEL=
OLLAMA_MODEL=qwen2.5:7b

SUPABASE_URL=https://bglhsyhqwkzwxhcjgwva.supabase.co
SUPABASE_JWT_SECRET=
ALLOWED_EMAILS=
ADMIN_EMAILS=

# SQLite for local dev; paste your Supabase pooler URL for the deployed DB
DATABASE_URL=sqlite:///./app.db
CORS_ORIGINS=http://localhost:3000